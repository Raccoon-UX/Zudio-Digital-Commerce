# ==============================================================================
# ZUDIO DIGITAL COMMERCE (CONCEPT PILOT) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Required: Standard PostgreSQL connection string.
# Production deployment requires: npx prisma migrate deploy
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zudio_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY (NextAuth.js)
# ------------------------------------------------------------------------------
# Canonical application URL (e.g. https://zudio.yourdomain.com in production)
NEXTAUTH_URL="http://localhost:3000"

# Secret used to encrypt NextAuth JWT session cookies.
# Generate in terminal: openssl rand -base64 32 (Must be >= 32 characters)
NEXTAUTH_SECRET="dev-secret-super-secret-key-at-least-32-chars-long"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (Razorpay Test Mode / Production)
# ------------------------------------------------------------------------------
# Get keys from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="razorpay_secret_placeholder"

# Webhook Secret from Razorpay Dashboard > Settings > Webhooks
# Target URL: https://<domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET="webhook_secret_placeholder"

# ------------------------------------------------------------------------------
# 4. GOOGLE MAPS PLATFORM (Store Locator)
# ------------------------------------------------------------------------------
# Optional: Google Maps JavaScript API key for interactive store maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ------------------------------------------------------------------------------
# 5. PUBLIC APPLICATION METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. DEMO SEED & CREDENTIAL CONTROLS (NON-PRODUCTION ONLY)
# ------------------------------------------------------------------------------
# Set to 'true' to allow 'npx prisma db seed' to create concept pilot test accounts.
# NOTE: Production environments (NODE_ENV=production) will NEVER create demo accounts.
DEMO_SEED_ENABLED="true"
DEMO_ADMIN_PASSWORD="Admin@12345"
DEMO_STAFF_PASSWORD="Staff@12345"
DEMO_CUSTOMER_PASSWORD="Customer@12345"
